# Copy to .env.prod on the EC2 instance and fill in. Never commit .env.prod.

# Where the images live, e.g. ghcr.io/your-github-username/courtbook
IMAGE_PREFIX=ghcr.io/CHANGE_ME/courtbook
TAG=latest

# Public hostname pointing at the instance's Elastic IP (a free subdomain works)
DOMAIN=courtbook.example.org

# RDS
RDS_HOST=courtbook.xxxxxxxx.us-east-1.rds.amazonaws.com
SPRING_DATASOURCE_USERNAME=courtbook
SPRING_DATASOURCE_PASSWORD=CHANGE_ME

# AWS (credentials come from the instance role)
AWS_REGION=us-east-1
COURTBOOK_EVENTS_QUEUE=courtbook-events
COURTBOOK_DYNAMODB_TABLE_PREFIX=courtbook-

# Services find the signing key here
COURTBOOK_JWKS_URI=http://user-service:8081/.well-known/jwks.json
# Base64 PKCS#8 RSA key: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 -w0
COURTBOOK_JWT_PRIVATE_KEY=CHANGE_ME

# Accounts registered with these emails become admins
COURTBOOK_ADMIN_EMAILS=you@stonybrook.edu

# Keep each JVM small so five fit in ~2.5 GB
JAVA_OPTS=-Xmx320m -XX:+UseSerialGC -XX:MaxMetaspaceSize=128m
